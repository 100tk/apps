    "license": "Proprietary",
    "notes": [
        "AI 生成应用 · 汇聚海量实用工具 · 连接 AI Agent"
    ],
    "url": "https://open.u-tools.cn/download/uTools-8.0.2.exe#/dl.7z",
    "hash": "FBBCC4B520D77B8F5AD336E98D89180CE868BF929583EE729C98F38C43809E44",
    "shortcuts": [
        [
            "utools.exe",
            "utools"
        ]
    ],
    "pre_install": [
        "Expand-7zipArchive -Path $dir\\`$PLUGINSDIR\\app-64.7z -DestinationPath $dir",
        "Remove-Item -Path $dir\\`$PLUGINSDIR, $dir\\`$R0 -Recurse -Force",
        "$FolderPath = Join-Path $env:APPDATA 'utools'",
        "if (Test-Path $FolderPath) {",
        "    if ((get-item $FolderPath -Force).Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "        return",
        "    }",
        "    New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
        "    Get-ChildItem -Path $FolderPath -Force | Copy-Item -Destination $persist_dir -Recurse -Force",
        "    Remove-Item -Path $FolderPath -Recurse -Force",
        "}",
        "else {",
        "    New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
        "}",
        "New-Item -ItemType Junction -Path $FolderPath -Target $persist_dir | Out-Null"
    ],
    "pre_uninstall": [
        "if ($purge) {",
        "    $FolderPath = Join-Path $env:APPDATA 'utools'",
        "    if (Test-Path $FolderPath) {",
        "        if ((Get-Item $FolderPath -Force).Attributes -band [System.IO.FileAttributes]::ReparsePoint) {",
        "            Remove-Item $FolderPath -Force -Recurse",
        "        }",
        "    }",
        "}"
    ],
    "checkver": {
        "url": "https://www.u-tools.cn/download",
        "regex": "v(?<version>\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "url": "https://open.u-tools.cn/download/uTools-$version.exe#/dl.7z",
        "hash": {
            "mode": "download"
        }
    }
}
