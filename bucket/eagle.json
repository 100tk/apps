{
    "##": "素材管理从未如此简单",
    "version": "4.0.23",
    "description": "Eagle 素材管理",
    "homepage": "https://cn.eagle.cool",
    "license": "",
    "notes": "使用 Eagle 轻松收集及整理“案例、灵感、截图、图片、视频、音频、情绪板”等各种素材，激发更多创意灵感，让工作变得更有效率！",
    "architecture": {
        "64bit": {
            "url": "https://r2-app.eagle.cool/releases/Eagle-4.0-x64-build23.exe#/install.exe",
            "hash": "6F92AECB6C53F5E3A9DEE49605F1955AE116E2ADCD5ED2E6DE1D19D732F94D38"
        }
    },
    "shortcuts": [
        [
            "eagle.exe",
            "Eagle素材管理"
        ]
    ],
    "installer": {
        "script": [
            "Start-Process -FilePath \"$dir\\install.exe\" -WorkingDirectory \"$dir\" -ArgumentList \"/S /D=$dir\" -Wait"
        ]
    },
    "uninstaller": {
        "script": [
            "Start-Process -FilePath \"$dir\\uninst.exe\" -ArgumentList \"/S\" -Wait"
        ]
    },
    "pre_install": [
        "$FolderPath = Join-Path $env:APPDATA 'eagle'",
        "if (Test-Path $FolderPath) {",
        "    if ( (Get-item $FolderPath -Force).LinkType ) {",
        "        return",
        "    }",
        "    New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
        "    Get-ChildItem -Path $FolderPath -Force | Copy-Item -Destination $persist_dir -Recurse -Force",
        "    Remove-Item -Path $FolderPath -Recurse -Force",
        "}",
        "else {",
        "    New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
        "}",
        "New-Item -ItemType Junction -Path $FolderPath -Target $persist_dir | Out-Null"
    ],
    "pre_uninstall": [
        "if ($purge) {",
        "    $FolderPath = Join-Path $env:APPDATA 'eagle'",
        "    if (Test-Path $FolderPath) {",
        "        if ((Get-item $FolderPath -Force).LinkType) {",
        "            Remove-Item $FolderPath -Force -Recurse",
        "        }",
        "    }",
        "}"
    ],
    "checkver": {
        "url": "https://cn.eagle.cool",
        "regex": "版本"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://r2-app.eagle.cool/releases/Eagle-4.0-x64-build23.exe"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
